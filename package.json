{
  "name": "@j1nn0/vanilla-autokana",
  "version": "1.3.0",
  "description": "A JavaScript library to complete furigana automatically (forked from ryo-utsunomiya/vanilla-autokana).",
  "author": "j1nn0 <j1nn0.github@gmail.com>",
  "contributors": [
    "j1nn0 <j1nn0.github@gmail.com>",
    "Ryo Utsunomiya <millionsnowliving@gmail.com>"
  ],
  "license": "MIT",
  "main": "dist/autokana.umd.js",
  "module": "dist/autokana.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/autokana.es.js",
      "require": "./dist/autokana.umd.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/j1nn0/vanilla-autokana.git"
  },
  "bugs": {
    "url": "https://github.com/j1nn0/vanilla-autokana/issues"
  },
  "homepage": "https://github.com/j1nn0/vanilla-autokana#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "oxlint src __tests__",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publish": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm publish"
  },
  "devDependencies": {
    "@storybook/html": "^10.3.6",
    "@storybook/html-vite": "^10.3.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.3.6",
    "typescript": "^6.0.2",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.4",
    "vue": "^3.5.34"
  }
}
