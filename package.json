{
  "name": "@j1nn0/vanilla-autokana",
  "version": "1.3.0",
  "description": "A JavaScript library to complete furigana automatically (forked from ryo-utsunomiya/vanilla-autokana).",
  "author": "j1nn0 <j1nn0.github@gmail.com>",
  "contributors": [
    "j1nn0 <j1nn0.github@gmail.com>",
    "Ryo Utsunomiya <millionsnowliving@gmail.com>"
  ],
  "license": "MIT",
  "main": "dist/autokana.umd.js",
  "module": "dist/autokana.es.js",
  "types": "types/autokana.d.ts",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/j1nn0/vanilla-autokana.git"
  },
  "bugs": {
    "url": "https://github.com/j1nn0/vanilla-autokana/issues"
  },
  "homepage": "https://github.com/j1nn0/vanilla-autokana#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "oxlint src __tests__",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "publish": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm publish"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "^29.0.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.59.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
